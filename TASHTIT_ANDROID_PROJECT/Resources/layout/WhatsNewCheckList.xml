<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#9DC3C2">

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <CheckBox
        android:id="@+id/checkBoxEye"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Eye check"
        android:textSize="25sp"
            android:textColor="#293D51"
        android:layout_marginBottom="5dp"
        android:layout_marginTop="5dp"
    />

    <CheckBox
        android:id="@+id/checkBoxDoc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Doctor check for green form"
        android:textSize="25sp"
            android:textColor="#293D51"
        android:layout_marginBottom="5dp"
    />

    <CheckBox
        android:id="@+id/checkBoxGreen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Green form"
        android:textSize="25sp"
            android:textColor="#293D51"
        android:layout_marginBottom="5dp"
    />

    <CheckBox
        android:id="@+id/checkBoxTheory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Theory"
        android:textSize="25sp"
            android:textColor="#293D51"
        android:layout_marginBottom="5dp"
    />

    <CheckBox
        android:id="@+id/checkBoxInnerTest"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Inner test"
        android:textSize="25sp"
            android:textColor="#293D51"
        android:layout_marginBottom="5dp"
    />

    <CheckBox
        android:id="@+id/checkBoxOutterTest"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Outter test"
        android:textSize="25sp"
            android:textColor="#293D51"
        android:layout_marginBottom="5dp"
    />

    <CheckBox
        android:id="@+id/checkBoxMorning"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Veteran passenger for the mornings"
        android:textSize="25sp"
            android:textColor="#293D51"
        android:layout_marginBottom="5dp"
    />

    <CheckBox
        android:id="@+id/checkBoxEvening"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Veteran passenger for the evenings"
        android:textSize="25sp"
            android:textColor="#293D51"
    />

    <Button
        android:id="@+id/btnApply"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="50dp"
        android:text="Apply"
            android:textSize="25sp"
        android:textColor="#4D7298"
        android:background="#D0EFB1"
        android:layout_margin="10sp"
    />

</LinearLayout>
</ScrollView>