
    <ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#9DC3C2">

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Driving Lessons Manager"
        android:textSize="30dp"
        android:gravity="center"
        android:textColor="#293D51"
    />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Logged as Guest"
        android:gravity="center"
        android:textSize="20sp"
        android:layout_marginTop="30dp"
        android:id="@+id/txtLoggedAs"
    />

    <Button
        android:id="@+id/btnStudentLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
		android:layout_gravity="center"
		android:text="Student Login"
        android:textSize="25sp"
        android:layout_marginBottom="5dp"
        android:layout_marginTop="40dp"
            android:textSize="25sp"
        android:textColor="#4D7298"
        android:background="#D0EFB1"
        android:layout_margin="10sp"
    />

    <Button
        android:id="@+id/btnTeacherLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
		android:layout_gravity="center"
		android:text="Teacher Login"
        android:textSize="25sp"
        android:layout_marginBottom="5dp"
            android:textSize="25sp"
        android:textColor="#4D7298"
        android:background="#D0EFB1"
        android:layout_margin="10sp"
    />

    <Button
        android:id="@+id/btnList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
		android:layout_gravity="center"
		android:text="List of Lessons"
        android:textSize="25sp"
        android:layout_marginBottom="5dp"
            android:textSize="25sp"
        android:textColor="#4D7298"
        android:background="#D0EFB1"
        android:layout_margin="10sp"
	/>

    <Button
        android:id="@+id/btnCall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
		android:layout_gravity="center"
		android:text="Call Teacher"
        android:textSize="25sp"
        android:layout_marginBottom="5dp"
            android:textSize="25sp"
        android:textColor="#4D7298"
        android:background="#D0EFB1"
        android:layout_margin="10sp"
    />

    <Button
        android:id="@+id/btnInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
		android:text="Info"
        android:textSize="25sp"
        android:layout_marginBottom="5dp"
            android:textSize="25sp"
        android:textColor="#4D7298"
        android:background="#D0EFB1"
        android:layout_margin="10sp"
    />

    <Button
        android:id="@+id/btnCheckList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
		android:layout_gravity="center"
		android:text="Whats left?"
        android:textSize="25sp"
        android:layout_marginBottom="5dp"
            android:textSize="25sp"
        android:textColor="#4D7298"
        android:background="#D0EFB1"
        android:layout_margin="10sp"
	/>

</LinearLayout>

</ScrollView>